{
  "name": "paysah",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo:gate": "tsx scripts/demo-gate.ts",
    "demo:exceptions": "tsx scripts/demo-exceptions.ts",
    "mock:orbyte": "tsx scripts/mock-orbyte.ts",
    "eval:e2e": "tsx scripts/evaluate-finalist.ts",
    "smoke:finalist": "tsx scripts/smoke-finalist.ts",
    "smoke:live-fixes": "tsx scripts/smoke-live-fixes.ts",
    "score:finalist": "tsx scripts/score-finalist-study.ts",
    "fixtures:images": "tsx scripts/generate-receipts.ts",
    "eval:ocr": "tsx scripts/evaluate-ocr.ts",
    "fixtures:ocr-expanded": "tsx scripts/generate-ocr-dataset.ts",
    "eval:ocr-expanded": "tsx scripts/evaluate-ocr-expanded.ts",
    "eval:runpod": "tsx --env-file-if-exists=.env scripts/evaluate-runpod.ts",
    "test:runpod": "tsx --test tests/integration/runpod-evaluation.test.ts",
    "verify:local": "tsx --env-file-if-exists=.env scripts/verify-local.ts",
    "verify:clean": "tsx --env-file-if-exists=.env scripts/reproduce-clean.ts",
    "study:serve": "tsx --env-file-if-exists=.env scripts/study-serve.ts",
    "study:dry-run": "tsx --env-file-if-exists=.env scripts/study-dry-run.ts",
    "study:browser": "tsx --env-file-if-exists=.env scripts/study-browser-preflight.ts",
    "study:rehearse": "tsx --env-file-if-exists=.env scripts/study-env.ts rehearse",
    "study:prepare": "tsx --env-file-if-exists=.env scripts/study-env.ts prepare",
    "replit:preflight": "tsx --env-file-if-exists=.env scripts/replit-preflight.ts",
    "replit:cloud-check": "tsx scripts/replit-cloud-check.ts",
    "replit:bundle": "tsx scripts/replit-bundle.ts",
    "smoke:m2": "tsx --env-file-if-exists=.env scripts/smoke-m2.ts",
    "smoke:m3": "tsx --env-file-if-exists=.env scripts/smoke-m3.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/receipt-worker.ts",
    "worker:once": "tsx --env-file-if-exists=.env scripts/receipt-worker.ts --once",
    "storage:cleanup": "tsx --env-file-if-exists=.env scripts/receipt-storage-cleanup.ts",
    "db:local:start": "tsx scripts/db-local.ts start",
    "db:local:stop": "tsx scripts/db-local.ts stop",
    "db:local:status": "tsx scripts/db-local.ts status",
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env apps/api/src/server.ts\" \"vite --config apps/web/vite.config.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p apps/api/tsconfig.json && tsx scripts/write-build-version.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "start:deployment": "node --env-file-if-exists=.env dist/apps/api/src/deployment.js",
    "smoke:deployment": "tsx --env-file-if-exists=.env scripts/smoke-deployment.ts",
    "test": "tsx --env-file-if-exists=.env --test tests/integration/*.test.ts",
    "test:db": "tsx --env-file-if-exists=.env --test tests/integration/orders.test.ts tests/integration/verification.test.ts tests/integration/receipt-images.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-setup.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-setup.ts seed",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "eval:runpod-vlm": "tsx --env-file-if-exists=.env scripts/eval-runpod-vlm.ts",
    "eval:openai-vlm": "tsx --env-file-if-exists=.env scripts/eval-openai-vlm.ts",
    "runpod:check": "tsx --env-file-if-exists=.env scripts/eval-runpod-vlm.ts --limit=1",
    "test:intake": "tsx --env-file-if-exists=.env --test tests/integration/intake.test.ts",
    "smoke:intake": "tsx --env-file-if-exists=.env scripts/smoke-intake.ts",
    "smoke:ui-v4": "tsx --env-file-if-exists=.env scripts/smoke-ui-v4.ts"
  },
  "dependencies": {
    "@replit/object-storage": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "express": "5.1.0",
    "multer": "2.4.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "three": "0.186.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "concurrently": "9.2.5",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
