PORT=3000
# Build-time only. Set to the exact verified source SHA for an archive/Replit build.
# PAYSAH_BUILD_COMMIT=<40 lowercase hexadecimal characters; update every release>
HOST=127.0.0.1
DEMO_MODE=true
EXTRACTOR_MODE=fixture
STORAGE_DRIVER=local
# Replit: choose STORAGE_DRIVER=replit, private dedicated bucket and stable prefix.
# REPLIT_STORAGE_BUCKET_ID=
REPLIT_STORAGE_PREFIX=paysah-receipts-v1
# Empty-queue wait doubles from 1s to this cap; resets after work.
WORKER_IDLE_MAX_MS=30000
# Optional private image directory; default .local/receipt-images (module-relative).
# RECEIPT_STORAGE_DIR=
# Optional team/judge-only multipart upload credential (at least 32 characters).
# Leave unset to disable arbitrary upload; synthetic catalog selection still works.
UPLOAD_ACCESS_KEY=
# CPU OCR: choose EXTRACTOR_MODE=cpu_ocr and run npm run worker separately.
# Required for M1 accounts, orders, migrations and seed; optional for health only.
# Local compose credentials only; replace with your provider URL when deploying.
DATABASE_URL=postgresql://paysah:paysah_local_only@127.0.0.1:55432/paysah
# Sessions use random bearer tokens, stored as SHA-256 hashes in PostgreSQL.
# Tests use an isolated temporary schema in TEST_DATABASE_URL (never a production DB).
TEST_DATABASE_URL=postgresql://paysah:paysah_local_only@127.0.0.1:55432/paysah_test
# EXTRACTOR_MODE=runpod: worker reads receipts with a vision model on a RunPod Serverless vLLM endpoint,
# falling back to CPU OCR on failure (D-023). Key stays server-side. Also used by eval:runpod-vlm.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Below the 180 s job lease (5000–80000), including CPU cross-check/fallback.
RUNPOD_TIMEOUT_MS=75000
# Private JSON budget/model/endpoint review, needed only with eval:runpod -- --live.
# RUNPOD_EVAL_REVIEW_FILE=.local/runpod-review.json
# For >1 live image: prior one-image FINISHED report, same endpoint/model/dataset.
# RUNPOD_EVAL_SMOKE_REPORT=evaluation/runpod/live-.../results.json

# Automatic receipt intake (disabled by default). Only team accounts and synthetic images.
# Never set webhook/Google triggers until separately authorized and proof can be recorded.
TELEGRAM_ENABLED=false
TELEGRAM_INTAKE_MODE=allowlist
# demo_link must be explicitly enabled and requires a demo tenant and valid order link.
# Keep the allowlist secret until compatible code has been deployed.
TELEGRAM_MAX_IMAGES_PER_HOUR=10
TELEGRAM_MAX_TENANT_IMAGES_PER_DAY=100
TELEGRAM_MAX_GLOBAL_IMAGES_PER_DAY=200
TELEGRAM_MAX_STARTS_PER_HOUR=30
GOOGLE_FORM_ENABLED=false
# TELEGRAM_TENANT_ID=<server-owned tenant UUID>
# TELEGRAM_CONNECTOR_ID=team-bot
# TELEGRAM_BOT_TOKEN=<server secret>
# TELEGRAM_WEBHOOK_SECRET=<at least 32 random characters>
# TELEGRAM_BOT_USERNAME=<BotFather username without @>
# TELEGRAM_ALLOWED_SENDERS=<numeric team user IDs separated by commas>
# INTAKE_HMAC_SECRET=<at least 32 random characters, keep stable>
# GOOGLE_FORM_TENANT_ID=<server-owned tenant UUID>
# GOOGLE_FORM_CONNECTOR_ID=team-form
# GOOGLE_FORM_INGEST_KEY=<independent random secret, at least 32 characters>
# GOOGLE_FORM_PREFILL_URL=https://docs.google.com/forms/d/e/<id>/viewform?entry.<item>={token}
